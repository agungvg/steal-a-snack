-- Rotation stored as a row-major 3x3 matrix { m11,m12,m13, m21,m22,m23, m31,m32,m33 }.
-- Position is a Vector3. Only the operations the factory uses are implemented.
local function matMul(a, b)
	local o = {}
	for r = 0, 2 do
		for c = 0, 2 do
